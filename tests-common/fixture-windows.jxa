// Opens one plain window for each title given, for a Spoon's tests, and keeps them open
// until the process is terminated. Run with osascript -l JavaScript; tests/fixture.js starts it.
//
// The windows belong to this process rather than to Hammerspoon 2, because hs_windowfilter-gt
// leaves Hammerspoon 2's own windows out of its default filter, which Spoons such as hs_window-gt
// use. Such a Spoon would then receive no events about them.
//
// Shared by every Spoon's tests: edit tests-common/fixture-windows.jxa, not a copy.

ObjC.import("Cocoa")

function run(argv) {
    const app = $.NSApplication.sharedApplication
    // A regular application, which shows an icon in the Dock while the tests run.
    // hs_windowfilter-gt tracks only standard applications, and an accessory application,
    // which would have no Dock icon, is not one: its windows would produce no events.
    app.setActivationPolicy($.NSApplicationActivationPolicyRegular)
    const style = $.NSWindowStyleMaskTitled | $.NSWindowStyleMaskClosable |
        $.NSWindowStyleMaskResizable | $.NSWindowStyleMaskMiniaturizable
    argv.forEach((title, i) => {
        const window = $.NSWindow.alloc.initWithContentRectStyleMaskBackingDefer(
            $.NSMakeRect(200 + 40 * i, 200 + 40 * i, 400, 300), style, $.NSBackingStoreBuffered, false)
        window.title = title
        window.releasedWhenClosed = false
        window.makeKeyAndOrderFront(null)
    })
    app.run
}
